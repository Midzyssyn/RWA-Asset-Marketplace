# 复制为 .env 后填写真实值。.env 已在 .gitignore，勿提交私钥 / API Key。

# --- Sepolia 部署 ---
# RPC：Infura / Alchemy / 公共节点均可
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC_URL

# 部署账户私钥（仅测试网专用账户；可带或不带 0x 前缀）
PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY

# Etherscan API Key（https://etherscan.io/apikey 申请，用于 hardhat verify）
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# --- 可选：seed-demo 使用的已部署地址（部署成功后从控制台复制）---
# VITE_MOCK_USDC_ADDRESS=0x...
# VITE_RWA_SHARE_ADDRESS=0x...
# VITE_RWA_VAULT_ADDRESS=0x...
